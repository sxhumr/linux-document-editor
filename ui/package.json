{
  "name": "pagelite-ui",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "test": "vitest run",
    "test:compat": "PAGELITE_LIBREOFFICE=1 vitest run tests/compatibility",
    "fixtures": "node tests/compatibility/fixtures/make-fixtures.ts && tests/compatibility/fixtures/make-libreoffice-fixtures.sh",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc -b",
    "demo-document": "node scripts/make-demo-document.ts"
  },
  "dependencies": {
    "@docx-editor.dev/core": "2.30.0",
    "@docx-editor.dev/react": "2.30.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@testing-library/react": "16.3.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "@xmldom/xmldom": "0.9.12",
    "docx": "9.11.0",
    "jsdom": "30.1.2",
    "jszip": "3.10.2",
    "oxlint": "^1.81.0",
    "prettier": "3.9.10",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vitest": "5.0.4"
  }
}
