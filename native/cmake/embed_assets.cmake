# Build-time script (cmake -P): embeds every file under ASSET_DIR into the binary.
#
# Writes two files:
#   ${OUT_DIR}/assets_blob.S     - one `.incbin` per file, so the bytes are linked in directly
#                                  (fast for multi-megabyte bundles, unlike hex-dumping)
#   ${OUT_DIR}/assets_index.cpp  - a sorted table of {path, begin, end} for pagelite::assets
#
# Run at build time rather than configure time because Vite emits content-hashed names.
cmake_minimum_required(VERSION 3.24)

if(NOT IS_DIRECTORY "${ASSET_DIR}")
  message(FATAL_ERROR "embed_assets: ${ASSET_DIR} does not exist; build the UI first")
endif()

file(GLOB_RECURSE files RELATIVE "${ASSET_DIR}" LIST_DIRECTORIES false "${ASSET_DIR}/*")
list(SORT files)

set(asm "/* Generated by embed_assets.cmake. Do not edit. */\n.section .rodata\n")
set(decls "")
set(rows "")
set(index 0)
foreach(rel IN LISTS files)
  set(sym "pagelite_asset_${index}")
  string(REPLACE "\\" "\\\\" abs_escaped "${ASSET_DIR}/${rel}")
  string(REPLACE "\"" "\\\"" abs_escaped "${abs_escaped}")
  string(APPEND asm ".balign 16\n.global ${sym}\n${sym}:\n.incbin \"${abs_escaped}\"\n.global ${sym}_end\n${sym}_end:\n")
  string(APPEND decls "extern const unsigned char ${sym}[];\nextern const unsigned char ${sym}_end[];\n")
  string(REPLACE "\"" "\\\"" rel_escaped "${rel}")
  string(APPEND rows "    {\"/${rel_escaped}\", ${sym}, ${sym}_end},\n")
  math(EXPR index "${index} + 1")
endforeach()
string(APPEND asm ".section .note.GNU-stack,\"\",@progbits\n")

set(cpp "// Generated by embed_assets.cmake. Do not edit.
#include \"assets.hpp\"

extern \"C\" {
${decls}}

namespace pagelite::assets::detail {

// Sorted by path (CMake sorts the glob), so lookups can binary-search.
const EmbeddedFile kFiles[] = {
${rows}};
const std::size_t kFileCount = ${index};

} // namespace pagelite::assets::detail
")

# Only touch the outputs when content changes, so unchanged UI builds do not relink.
foreach(pair "assets_blob.S;asm" "assets_index.cpp;cpp")
  list(GET pair 0 name)
  list(GET pair 1 var)
  set(path "${OUT_DIR}/${name}")
  set(old "")
  if(EXISTS "${path}")
    file(READ "${path}" old)
  endif()
  if(NOT old STREQUAL "${${var}}")
    file(WRITE "${path}" "${${var}}")
  endif()
endforeach()
